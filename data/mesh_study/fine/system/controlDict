FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
application     simpleFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         6000;
deltaT          1;
writeControl    timeStep;
writeInterval   250;
purgeWrite      1;
writeFormat     ascii;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable false;

functions
{
    forceCoeffs
    {
        type            forceCoeffs;
        libs            (forces);
        writeControl    timeStep;
        writeInterval   1;
        log             yes;
        patches         (airfoil);
        rho             rhoInf;
        rhoInf          1.0000;
        liftDir         (-0.06975647 0.99756405 0);
        dragDir         (0.99756405 0.06975647 0);
        CofR            (0.25 0 0);
        pitchAxis       (0 0 1);
        magUInf         1.0000;
        lRef            1.0000;
        Aref            0.100000;
    }
}
